+    roots = [Path(p) for p in search_roots] + [Path(__file__).resolve().parent]
+    candidates = [Path(recorded_path)] if recorded_path else []
+    candidates += [r / name for r in roots for name in
+                   dict.fromkeys([Path(recorded_path).name if recorded_path else filename, filename])]
+    for path in candidates:
+        if path.is_file():
+            return path.resolve()
+    raise FileNotFoundError(f"Mechanism {mechanism!r} not found: {candidates}")
 
 
