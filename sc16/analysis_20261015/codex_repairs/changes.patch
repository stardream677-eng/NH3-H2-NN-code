+def resolve_mechanism_file(mechanism="nuig_2024", recorded_path=None, search_roots=()):
+    """Resolve a moved mechanism by identity/name; callers verify its content hash."""
+    names = {"nuig_2024": "NUIG2024.yaml", "tsinghua_2024c": "TH2024.yaml", "ucf_2024": "UCF2024.yaml"}
